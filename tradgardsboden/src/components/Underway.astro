---
import Sprig from './Sprig.astro';
interface Props { etapp: string; }
const { etapp } = Astro.props;
---
<section>
  <div class="wrap underway">
    <Sprig size={48} />
    <p><strong>Sidan är under uppbyggnad.</strong> Den byggs i {etapp}.</p>
    <a href="/" class="text-link">Till startsidan <span aria-hidden="true">→</span></a>
  </div>
</section>
<style>
  .underway { display: flex; flex-direction: column; align-items: flex-start; gap: 16px; max-width: 640px; }
  .underway :global(.sprig) { color: var(--leaf-text); }
  strong { color: var(--heading); }
</style>
