---
interface Props { eyebrow: string; title: string; lede?: string; }
const { eyebrow, title, lede } = Astro.props;
---
<section class="page-intro">
  <div class="wrap">
    <div class="eyebrow">{eyebrow}</div>
    <h1 class="section-title" set:html={title} />
    {lede && <p class="lede">{lede}</p>}
    <slot />
  </div>
</section>
<style>
  .page-intro { padding: 96px 0 56px; border-bottom: 1px solid var(--hairline); }
  h1 { font-size: clamp(34px, 4.6vw, 54px); }
  @media (max-width: 860px) { .page-intro { padding: 64px 0 40px; } }
</style>
