---
/*
  Tillfällig stämningsillustration för startsidan: böljande Österlenlandskap
  med en rad blommande fruktträd och havet i fjärran.
  Ersätts med ett licensierat foto när ett sådant finns.
*/
let seed = 7;
const rand = () => {
  seed = (seed * 16807) % 2147483647;
  return (seed - 1) / 2147483646;
};

// Kullens överkant där träden står (y för ett givet x)
const hill = (x: number) => 552 + Math.sin(x / 260) * 12 + Math.sin(x / 90 + 1) * 4;

const trees = Array.from({ length: 11 }, (_, i) => {
  const x = 90 + i * 142 + (rand() - 0.5) * 36;
  const s = 0.55 + rand() * 0.25;
  const base = hill(x);
  const crown = Array.from({ length: 7 }, () => ({
    cx: x + (rand() - 0.5) * 90 * s,
    cy: base - 120 * s - rand() * 70 * s,
    r: (30 + rand() * 26) * s,
  }));
  const blossoms = Array.from({ length: 34 }, () => ({
    cx: x + (rand() - 0.5) * 120 * s,
    cy: base - 95 * s - rand() * 110 * s,
    r: 2 + rand() * 2.6,
  }));
  return { x, s, base, crown, blossoms };
});
---
<svg class="hero-art" viewBox="0 0 1600 1000" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="ha-sky" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#c9d6cf" />
      <stop offset="0.55" stop-color="#ebe3d2" />
      <stop offset="1" stop-color="#f3e6cf" />
    </linearGradient>
    <linearGradient id="ha-sea" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#9fb4b0" />
      <stop offset="1" stop-color="#b9c7bf" />
    </linearGradient>
    <linearGradient id="ha-field1" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#b8c19a" />
      <stop offset="1" stop-color="#a3ae86" />
    </linearGradient>
    <linearGradient id="ha-field2" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#7f9271" />
      <stop offset="1" stop-color="#5f7556" />
    </linearGradient>
    <linearGradient id="ha-field3" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#4f6648" />
      <stop offset="1" stop-color="#2f4a3a" />
    </linearGradient>
    <radialGradient id="ha-sun" cx="0.72" cy="0.3" r="0.4">
      <stop offset="0" stop-color="#fbf1dc" stop-opacity="0.95" />
      <stop offset="1" stop-color="#fbf1dc" stop-opacity="0" />
    </radialGradient>
  </defs>

  <rect width="1600" height="1000" fill="url(#ha-sky)" />
  <rect width="1600" height="1000" fill="url(#ha-sun)" />

  <!-- Havet vid horisonten -->
  <rect y="455" width="1600" height="40" fill="url(#ha-sea)" />

  <!-- Avlägsna fält -->
  <path d="M0 480 C 260 450, 520 470, 800 462 S 1350 440, 1600 470 V 1000 H 0 Z" fill="url(#ha-field1)" />
  <path d="M0 520 C 300 500, 620 530, 980 505 S 1400 500, 1600 520 V 1000 H 0 Z" fill="#c6c69a" opacity="0.6" />
  <!-- Rapsfält som ett tunt band -->
  <path d="M520 515 C 700 506, 900 512, 1120 503 L 1140 518 C 920 528, 720 526, 520 532 Z" fill="#e3cf7a" opacity="0.55" />

  <!-- Mellangrund -->
  <path d="M0 552 C 240 528, 520 548, 820 538 S 1360 528, 1600 550 V 1000 H 0 Z" fill="url(#ha-field2)" />

  <!-- Fruktträdsraden -->
  <g>
    {trees.map((t) => (
      <g>
        <path d={`M${t.x} ${t.base} C ${t.x - 3} ${t.base - 50 * t.s}, ${t.x + 4} ${t.base - 80 * t.s}, ${t.x} ${t.base - 110 * t.s}`}
          stroke="#4a3b2f" stroke-width={7 * t.s} fill="none" stroke-linecap="round" />
        {t.crown.map((c) => <circle cx={c.cx} cy={c.cy} r={c.r} fill="#6f8763" opacity="0.92" />)}
        {t.crown.map((c) => <circle cx={c.cx - c.r * 0.25} cy={c.cy - c.r * 0.3} r={c.r * 0.7} fill="#8ea37e" opacity="0.55" />)}
        {t.blossoms.map((b) => <circle cx={b.cx} cy={b.cy} r={b.r} fill="#f7e9e4" opacity="0.9" />)}
      </g>
    ))}
  </g>

  <!-- Förgrund -->
  <path d="M0 640 C 300 600, 700 650, 1000 618 S 1450 610, 1600 636 V 1000 H 0 Z" fill="url(#ha-field3)" />
</svg>

<style>
  .hero-art { width: 100%; height: 100%; }
</style>
