---
// Signaturmotiv: en tunn, handritad kvist med två blad. Används sparsamt.
interface Props { size?: number; class?: string; }
const { size = 40, class: className = '' } = Astro.props;
---
<svg class:list={['sprig', className]} width={size} height={size} viewBox="0 0 48 48" aria-hidden="true" focusable="false">
  <path d="M10 40 C 18 32, 24 24, 36 9" />
  <path d="M21 28 C 15 26, 12 20, 13 14 C 19 16, 22 22, 21 28 Z" />
  <path d="M28 19 C 33 20, 38 18, 41 13 C 36 11, 30 13, 28 19 Z" />
  <circle cx="37.5" cy="8" r="2.2" />
</svg>
<style>
  .sprig path, .sprig circle {
    fill: none; stroke: currentColor; stroke-width: 1.3; stroke-linecap: round; stroke-linejoin: round;
  }
</style>
