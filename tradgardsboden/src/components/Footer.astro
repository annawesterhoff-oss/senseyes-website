---
import Wordmark from './Wordmark.astro';
import { huvudmeny, juridik } from './nav';
---
<footer class="site-footer">
  <div class="wrap">
    <div class="footer-top">
      <div class="footer-brand">
        <Wordmark tone="light" />
        <p class="footer-tagline">Fruktträd &amp; trädgårdsväxter för skånska trädgårdar.</p>
        <p class="footer-place">Sankt Olof · Österlen · Skåne</p>
      </div>
      <nav class="footer-col" aria-label="Sidfot – sidor">
        <h2>Butiken</h2>
        {huvudmeny.map((l) => <a href={l.href}>{l.text}</a>)}
      </nav>
      <nav class="footer-col" aria-label="Sidfot – villkor">
        <h2>Villkor &amp; info</h2>
        {juridik.map((l) => <a href={l.href}>{l.text}</a>)}
      </nav>
      <div class="footer-col">
        <h2>Kontakt</h2>
        <a href="/kontakt/" class="icon-link">
          <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3 7l9 6 9-6" /></svg>
          Skicka ett meddelande
        </a>
        <p>Avhämtning i Sankt Olof efter överenskommelse.</p>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© {new Date().getFullYear()} Trädgårdsboden</span>
      <span>Inga spårningscookies på den här webbplatsen.</span>
    </div>
  </div>
</footer>

<style>
  .site-footer { background: var(--soil); color: #c9d3c2; padding: 80px 0 36px; }
  .footer-top {
    display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr; gap: 40px;
    padding-bottom: 48px; border-bottom: 1px solid rgba(246, 241, 231, 0.1);
  }
  .footer-tagline { font-family: var(--serif); font-size: 16px; color: #dfe5d8; margin-top: 22px; max-width: 30ch; }
  .footer-place { font-size: 12.5px; letter-spacing: 0.14em; text-transform: uppercase; color: #93a08f; margin-top: 14px; }
  .footer-col h2 {
    font-family: var(--sans); font-size: 12.5px; letter-spacing: 0.14em; text-transform: uppercase;
    color: #93a08f; margin-bottom: 18px; font-weight: 600;
  }
  .footer-col a, .footer-col p { display: block; font-size: 14.5px; margin-bottom: 10px; color: #c9d3c2; }
  .footer-col a:hover { color: var(--on-dark); }
  .icon-link { display: flex !important; align-items: center; gap: 10px; }
  .icon-link svg rect, .icon-link svg path { fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .footer-bottom {
    display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px;
    padding-top: 28px; font-size: 13px; color: #93a08f;
  }
  @media (max-width: 860px) {
    .site-footer { padding: 64px 0 32px; }
    .footer-top { grid-template-columns: 1fr 1fr; gap: 36px 24px; }
    .footer-brand { grid-column: 1 / -1; }
    .footer-bottom { flex-direction: column; }
  }
  @media (max-width: 420px) {
    .footer-top { grid-template-columns: 1fr; }
  }
</style>
