---
import Sprig from './Sprig.astro';
interface Props { tone?: 'dark' | 'light'; }
const { tone = 'dark' } = Astro.props;
---
<a href="/" class:list={['wordmark', tone]} aria-label="Trädgårdsboden – till startsidan">
  <Sprig size={30} class="wordmark-sprig" />
  <span>Trädgårds<em>boden</em></span>
</a>
<style>
  .wordmark {
    display: inline-flex; align-items: center; gap: 10px;
    font-family: var(--serif); font-size: 24px; font-weight: 500; letter-spacing: 0.005em;
    color: var(--heading);
  }
  .wordmark em { font-style: italic; font-weight: 400; color: var(--forest); }
  .wordmark :global(.wordmark-sprig) { color: var(--leaf-text); flex-shrink: 0; }
  .wordmark.light { color: var(--on-dark); }
  .wordmark.light em { color: #b9c9ae; }
  .wordmark.light :global(.wordmark-sprig) { color: #b9c9ae; }
</style>
